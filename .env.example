# Firebase web config (Project settings → Your apps → jobbot-web). Public identifiers, not secrets;
# access is enforced by Firestore security rules + Auth authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Auth uid allowed to read/write live data (set after first sign-in)
VITE_OWNER_UID=
